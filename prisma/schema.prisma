// Jakebox data model — see docs/Jakebox_Architecture_v1.docx for full context

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  admin
  user
}

enum UserStatus {
  active
  banned
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  // Nullable: an account created via Google/Facebook sign-in has no
  // password at all. The Credentials provider's authorize() treats a null
  // passwordHash as "this account can't log in with a password" rather
  // than attempting bcrypt.compare against it.
  passwordHash  String?
  displayName   String?
  role          UserRole @default(user)
  status        UserStatus @default(active)
  creditBalance Int      @default(0)

  tosAcceptedAt DateTime?
  tosVersion    String?

  // Login lockout: failedLoginAttempts resets to 0 on any successful login
  // or password reset; lockedUntil is set once it hits the 3-attempt
  // threshold (see authorize() in src/auth.ts) and cleared the same way.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditTransactions  CreditTransaction[]
  payments            Payment[]
  generations         Generation[]
  songs               Song[]
  moderationLogs      ModerationLog[]
  supportReports      SupportReport[]
  videoStudioJobs     VideoStudioJob[]
  clipVideoJobs       ClipVideoJob[]
  stylePresets        StylePreset[]
  voicePersonas       VoicePersona[]
  passwordResetTokens PasswordResetToken[]
}

// Forgot-password flow: the raw token is only ever emailed to the user,
// never stored -- tokenHash (sha256) is what's persisted, same pattern as
// passwordHash on User, so a DB leak alone can't be used to reset accounts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum CreditTransactionType {
  purchase
  signup_bonus
  generation_charge
  generation_refund
  admin_adjustment
}

model CreditTransaction {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id])
  type           CreditTransactionType
  amount         Int // signed: positive = credit, negative = debit
  balanceAfter   Int

  relatedPaymentId    String?
  relatedGenerationId String?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model Payment {
  id                      String        @id @default(cuid())
  userId                  String
  user                    User          @relation(fields: [userId], references: [id])
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  amountUsdCents          Int
  creditsPurchased        Int
  status                  PaymentStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum GenerationStatus {
  pending
  processing
  completed
  failed
  rejected_moderation
}

model Generation {
  id      String           @id @default(cuid())
  batchId String // groups multiple versions generated from the same submission
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  status  GenerationStatus @default(pending)

  stylePrompt  String
  instrumental Boolean @default(false)
  language     String  @default("en")

  // raw lyrics text, Suno-style: sections marked inline with tags like
  // [Verse], [Chorus] rather than split into separate structured fields --
  // makes it trivial to paste a full lyric block in one go.
  lyricsText String @default("")

  targetDurationSeconds Int
  actualDurationSeconds Int?

  creditsCharged  Int @default(0)
  creditsRefunded Int @default(0)

  elevenLabsRequestId String?
  errorMessage         String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  songs          Song[]
  moderationLogs ModerationLog[]

  @@index([userId])
  @@index([status])
  @@index([batchId])
}

model Song {
  id           String     @id @default(cuid())
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  title          String
  audioUrl       String
  format         String // "mp3" | "wav"
  durationSeconds Int
  fileSizeBytes   Int

  // Which backend actually generated this song ("elevenlabs" | "treblo" |
  // "mureka" | "musicapi") -- musicProvider.ts falls through to the next
  // configured provider on a quota/credit error, so this records which one
  // won for a given generation. Nullable: rows created before this field
  // existed don't have it.
  provider String?

  // [{ word: string, start: number, end: number }] in seconds, from
  // ElevenLabs' with_timestamps option -- powers the synced lyrics player.
  wordTimestamps Json?

  // Auto-generated vertical video (waveform + title/style text, see
  // src/lib/video.ts) -- storage key under storage/videos/, mirroring
  // audioUrl. Null if video generation hasn't run yet or failed (it's
  // best-effort and never blocks the song itself from completing).
  videoUrl String?

  // A still frame grabbed from that same generated video, used as the
  // song's cover thumbnail in the library list -- storage key under
  // storage/thumbnails/. Null whenever videoUrl is (no video, no frame to
  // grab from).
  thumbnailUrl String?

  deletedAt DateTime? // soft delete, keeps row for dispute/takedown handling

  createdAt DateTime @default(now())

  supportReports  SupportReport[]
  videoStudioJobs VideoStudioJob[]
  clipVideoJobs   ClipVideoJob[]

  @@index([userId])
  @@index([generationId])
}

enum ModerationStage {
  keyword_filter
  openai_moderation
  elevenlabs_rejection
}

model ModerationLog {
  id           String          @id @default(cuid())
  generationId String?
  generation   Generation?     @relation(fields: [generationId], references: [id])
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  stage        ModerationStage
  flagged      Boolean
  categories   Json?
  action       String // "blocked" | "allowed"

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([generationId])
}

enum VideoStudioJobStatus {
  running
  done
  error
}

// Tracks a lyric-video render handed off to the separate VideoSubtitles
// Flask service (see src/lib/videoStudio.ts) -- a richer Whisper-aligned
// captioned video + short-clip pipeline than Song.videoUrl's own lightweight
// auto-generated waveform video. That service is a local, single-user tool
// (no auth of its own), so access to /video and /studio in Jakebox is
// restricted to owner/admin.
model VideoStudioJob {
  id     String @id @default(cuid())
  songId String
  song   Song   @relation(fields: [songId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // The identifier VideoSubtitles uses for this render (its filenames are
  // derived from it directly) -- sanitized from the song title plus a
  // uniqueness suffix, see videoStudio.ts. Unique here too since it's the
  // join key back to the Flask side.
  name String @unique

  status       VideoStudioJobStatus @default(running)
  errorMessage String?

  videoUrl        String?
  durationSeconds Int?
  promoText       String?
  shortUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([songId])
}

enum ClipVideoJobStatus {
  processing
  done
  error
}

// Lets a user upload their own footage (2-6 clips) and have it stitched
// into one video -- normalized to a common canvas, crossfaded between
// clips, topped with one of their own finished songs -- entirely with
// ffmpeg server-side (see clipVideo.ts), no external AI video provider
// involved. Clip count is capped at MAX_CLIPS (clipVideo.ts) rather than
// left unbounded, to keep ffmpeg processing time and upload size sane on a
// shared Render instance.
model ClipVideoJob {
  id     String @id @default(cuid())
  songId String
  song   Song   @relation(fields: [songId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status       ClipVideoJobStatus @default(processing)
  errorMessage String?

  clipCount       Int
  videoUrl        String?
  durationSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([songId])
}

// User-saved style/genre prompts, reusable across generations from the
// Create sidebar -- separate from the free-text stylePrompt on Generation,
// which stays a per-submission snapshot.
model StylePreset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  name   String
  prompt String

  createdAt DateTime @default(now())

  @@index([userId])
}

enum VoicePersonaStatus {
  pending
  ready
  failed
}

// A voice cloned via MusicAPI's create-voice endpoint from a recorded/
// uploaded sample (see src/lib/musicapi.ts) -- reusable as the singer
// across later generations (task_type: "persona_music") once `personaId`
// is populated. The source recording is kept only long enough to be
// hosted at a public URL for the provider to fetch (see publicHost.ts);
// this row's `personaId` is what actually matters afterward.
model VoicePersona {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  name   String

  status       VoicePersonaStatus @default(pending)
  personaId    String? // set once MusicAPI's create-voice task completes
  errorMessage String?
  // Local storage key for the original recording/upload -- kept permanently
  // (separate from the short-lived R2 public URL used only to hand the
  // audio to MusicAPI) so the user can play back what they recorded, e.g.
  // to confirm it actually captured their voice before generating a song.
  audioUrl     String?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum SupportReportStatus {
  open
  reviewed
  actioned
}

model SupportReport {
  id      String               @id @default(cuid())
  userId  String
  user    User                 @relation(fields: [userId], references: [id])
  songId  String?
  song    Song?                @relation(fields: [songId], references: [id])
  message String
  status  SupportReportStatus  @default(open)

  createdAt DateTime @default(now())

  @@index([userId])
}
