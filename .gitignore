# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# locally-stored generated audio (dev only)
/storage

# background video loops for the auto-generated song video (large binaries,
# fetched/copied locally rather than committed)
/backgrounds

# ad-hoc video clip exports / FableCut project scratch (large binaries)
/VideoClipe
.claude/
__pycache__/
*.pyc
